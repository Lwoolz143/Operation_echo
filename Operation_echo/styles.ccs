* {
box-sizing: border-box;
}

html,
body {
margin: 0;
width: 100%;
min-height: 100%;
}

body {
display: grid;
place-items: center;
overflow: hidden;
padding: 24px;

background:
radial-gradient(circle at 50% 45%, rgba(95, 150, 82, 0.2), transparent 34%),
linear-gradient(145deg, rgb(5, 14, 8), rgb(13, 32, 18) 55%, rgb(4, 11, 7));

color: rgb(239, 235, 211);
font-family: "Segoe UI", Arial, sans-serif;
}

body::before {
content: "";
position: fixed;
inset: 0;
pointer-events: none;

background:
repeating-linear-gradient(
0deg,
rgba(255, 255, 255, 0.018) 0,
rgba(255, 255, 255, 0.018) 1px,
transparent 1px,
transparent 4px
);

opacity: 0.7;
}

body::after {
content: "";
position: fixed;
inset: 0;
pointer-events: none;
box-shadow: inset 0 0 160px 50px rgba(0, 0, 0, 0.85);
}

#startup {
position: relative;
width: min(720px, 92vw);
padding: 70px 36px;
text-align: center;

background:
linear-gradient(
145deg,
rgba(34, 59, 35, 0.72),
rgba(10, 24, 14, 0.86)
);

border: 1px solid rgba(219, 183, 101, 0.5);
border-radius: 4px;

box-shadow:
0 30px 90px rgba(0, 0, 0, 0.65),
inset 0 0 50px rgba(102, 157, 86, 0.08);

animation: terminalArrival 1.3s ease-out both;
}

#startup::before {
content: "";
position: absolute;
inset: 12px;
border: 1px solid rgba(219, 183, 101, 0.18);
pointer-events: none;
}

#startup::after {
content: "NPD FIELD TERMINAL • SECURE CONNECTION";
position: absolute;
top: 22px;
left: 50%;
transform: translateX(-50%);

width: max-content;
max-width: 80%;

color: rgba(224, 196, 127, 0.72);
font-size: 11px;
font-weight: 700;
letter-spacing: 3px;
}

.logo {
margin-bottom: 28px;

color: rgb(219, 183, 101);
font-family: Georgia, "Times New Roman", serif;
font-size: clamp(34px, 7vw, 62px);
font-weight: 700;
letter-spacing: clamp(4px, 1.2vw, 10px);
line-height: 1.1;

text-shadow:
0 0 18px rgba(219, 183, 101, 0.3),
0 3px 12px rgba(0, 0, 0, 0.8);
}

.department {
margin-bottom: 48px;

color: rgb(244, 238, 215);
font-family: Georgia, "Times New Roman", serif;
font-size: clamp(17px, 3vw, 24px);
line-height: 1.65;
}

.department::first-line {
color: rgb(156, 195, 138);
font-family: "Segoe UI", Arial, sans-serif;
font-size: 0.72em;
font-weight: 700;
letter-spacing: 4px;
}

#status {
position: relative;
display: inline-block;
min-width: min(430px, 78vw);
padding: 17px 22px;

background: rgba(2, 10, 5, 0.58);
border: 1px solid rgba(126, 185, 112, 0.32);

color: rgb(159, 211, 145);
font-family: Consolas, "Courier New", monospace;
font-size: clamp(14px, 2.5vw, 18px);
letter-spacing: 1px;

box-shadow:
inset 0 0 20px rgba(83, 164, 69, 0.08),
0 0 25px rgba(83, 164, 69, 0.08);
}

#status::after {
content: "";
display: inline-block;
width: 8px;
height: 1em;
margin-left: 8px;
vertical-align: -2px;

background: rgb(159, 211, 145);
box-shadow: 0 0 8px rgba(159, 211, 145, 0.8);

animation: cursorBlink 0.9s steps(1) infinite;
}

@keyframes terminalArrival {
from {
opacity: 0;
transform: scale(0.96) translateY(16px);
filter: blur(5px);
}

to {
opacity: 1;
transform: scale(1) translateY(0);
filter: blur(0);
}
}

@keyframes cursorBlink {
50% {
opacity: 0;
}
}

@media (max-width: 520px) {
body {
padding: 14px;
}

#startup {
padding: 62px 20px 50px;
}

#status {
min-width: 100%;
}
}